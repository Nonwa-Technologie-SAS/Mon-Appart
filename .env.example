# Copier vers .env à la racine. Ne jamais committer .env.

NODE_ENV=development
APP_ENV=local
APP_PORT=4000

# API NestJS — base dédiée, distincte du prototype web
DATABASE_URL=postgresql://mon_appart:mon_appart_dev@127.0.0.1:5433/mon_appart

# Tests d'intégration base de données. Le nom doit finir par _test :
# les scripts refusent toute autre base. Jamais l'URL de production.
TEST_DATABASE_URL=postgresql://mon_appart:mon_appart_dev@127.0.0.1:5433/mon_appart_test

# reference | development. Par défaut : development en local, reference ailleurs.
# SEED_PROFILE=

# Legacy web (mon_appart_legacy) : plus utilisé par apps/web (tout passe par Nest).
# WEB_DATABASE_URL=postgresql://mon_appart:mon_appart_dev@127.0.0.1:5433/mon_appart_legacy

REDIS_URL=redis://127.0.0.1:6380

# Secrets de développement uniquement. Les remplacer hors local.
# JWT_SECRET signe les access tokens. JWT_REFRESH_SECRET dérive la clé HMAC
# des refresh tokens, OTP et liens de réinitialisation : le changer invalide
# toutes les sessions et tous les codes en cours.
JWT_SECRET=dev-only-change-me-please-32chars-min
JWT_REFRESH_SECRET=dev-only-refresh-change-me-32chars
# Durées : <nombre><ms|s|m|h|d>
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Origines autorisées, séparées par des virgules. Vide = pas de CORS cross-origin.
# WEB_APP_URL et ADMIN_APP_URL y sont ajoutées automatiquement.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Base des liens envoyés par email (réinitialisation du mot de passe).
WEB_APP_URL=http://localhost:3000
ADMIN_APP_URL=http://localhost:3001
# Site public (SEO) — URL canonique, sans slash final.
# Exemple local : http://localhost:3000 — en production : https://www.exemple.ci
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Forcer l'indexation (true) ou le noindex (false). Par défaut : index seulement si NODE_ENV=production.
# NEXT_PUBLIC_SEO_INDEXING=false
# Autoriser un sitemap hors production (tests locaux uniquement).
# NEXT_PUBLIC_SEO_SITEMAP=true
# URL de l’API Nest (serveur) pour le rewrite Next `/api/v1/*` (apps/web).
NEST_API_URL=http://localhost:4000
# same-origin = rewrite Next (recommandé) ; URL absolue = CORS direct ; off = Nest désactivé.
NEXT_PUBLIC_NEST_API_URL=same-origin
# Valeur Express "trust proxy" derrière un reverse proxy (ex. 1). Vide en local.
# Le back-office relaie /api/* par le serveur Next : sans "loopback" (ou le
# nombre de proxys réel), limites de débit et IP d'audit voient l'IP du proxy.
TRUST_PROXY=
# Back-office (apps/admin) : URL de l'API vers laquelle /api/* est relayé
# (figée au `next build`).
ADMIN_API_URL=http://localhost:4000

# Identity : codes et liens
PASSWORD_RESET_TTL=30m
OTP_LENGTH=6
OTP_TTL=5m
OTP_MAX_ATTEMPTS=5
# Secondes entre deux envois de code
OTP_RESEND_COOLDOWN=60

# Identity : limites (fenêtres en secondes)
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOGIN_FAILURE_WINDOW=900
AUTH_RATE_LIMIT_WINDOW=60
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTER_RATE_LIMIT=5
AUTH_OTP_RATE_LIMIT=5
AUTH_RESET_RATE_LIMIT=5

# Affiche OTP et liens de réinitialisation sur la console. Refusé hors APP_ENV=local.
AUTH_DEV_PRINT_CODES=false

# Annonces : true = première publication soumise à la modération.
LISTING_MODERATION_REQUIRED=false
# Durée de publication par défaut, en jours (1 à 365)
LISTING_DEFAULT_DURATION_DAYS=90
# Vérifications exigées avant publication (virgules) : IDENTITY, PUBLICATION_RIGHT.
# Vide : aucune exigence (voir docs/trust-and-verification.md).
LISTING_PUBLICATION_REQUIREMENTS=

# Recherche. PostgreSQL suffit ; OpenSearch est optionnel (voir docs/search.md).
# postgres | opensearch
SEARCH_ENGINE=postgres
# postgres | none : repli si OpenSearch échoue
SEARCH_FALLBACK=postgres
SEARCH_DEFAULT_LIMIT=20
SEARCH_MAX_LIMIT=100
# 0 désactive le cache Redis des résultats
SEARCH_CACHE_TTL_SECONDS=60
SEARCH_MAX_RADIUS_KM=50
SEARCH_REINDEX_BATCH_SIZE=500
# Bornes des tranches de prix des facettes (XOF, croissantes)
SEARCH_PRICE_FACET_BOUNDS=100000,250000,500000,1000000,5000000,50000000
# Requêtes par minute et par client
SEARCH_RATE_LIMIT=60
SEARCH_SUGGEST_RATE_LIMIT=240
# Synonymes : "terme=variante|variante;..." (ex. commerce=magasin|boutique)
SEARCH_SYNONYMS=
# Version de l'index OpenSearch (listings_vN, alias listings_current)
SEARCH_INDEX_VERSION=1
# OpenSearch : laisser OPENSEARCH_NODE vide pour ne pas l'utiliser.
# Renseigné avec SEARCH_ENGINE=postgres, l'index est alimenté sans être interrogé.
OPENSEARCH_NODE=
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX_LISTINGS=listings
OPENSEARCH_TIMEOUT_MS=1000
# 0 à 2
OPENSEARCH_MAX_RETRIES=1

# Recommandations (voir docs/recommendation.md). Le moteur à règles suffit ;
# remote = service Python services/recommendation, avec repli sur les règles.
# rules | remote
RECOMMENDATION_ENGINE=rules
# Obligatoire avec RECOMMENDATION_ENGINE=remote (ex. http://localhost:8000)
RECOMMENDATION_SERVICE_URL=
RECOMMENDATION_SERVICE_TIMEOUT_MS=800
RECOMMENDATION_DEFAULT_LIMIT=20
# 50 au plus
RECOMMENDATION_MAX_LIMIT=50
# Profondeur paginable d'une liste
RECOMMENDATION_MAX_RESULTS=100
# Annonces candidates lues en une requête avant classement
RECOMMENDATION_CANDIDATE_POOL=400
# 0 désactive le cache Redis des listes
RECOMMENDATION_CACHE_TTL_SECONDS=300
# Durée de vie des recommandations persistées
RECOMMENDATION_TTL_DAYS=7
RECOMMENDATION_BEHAVIOR_LOOKBACK_DAYS=90
RECOMMENDATION_BEHAVIOR_HALF_LIFE_DAYS=30
# Âge maximal du profil de comportement avant recalcul (à la demande)
RECOMMENDATION_PROFILE_MAX_AGE_MINUTES=60
RECOMMENDATION_ENABLE_BEHAVIOR_SIGNALS=true
RECOMMENDATION_ENABLE_DIVERSIFICATION=true
# 0 = pertinence seule, 1 = diversité maximale
RECOMMENDATION_DIVERSITY=0.3
RECOMMENDATION_MAX_PER_OWNER=2
# Poids par dimension, somme = 100
RECOMMENDATION_WEIGHTS=budget:30,location:20,type:15,size:10,amenities:10,behavior:10,quality:5
# Requêtes par minute et par client
RECOMMENDATION_RATE_LIMIT=60
RECOMMENDATION_FEEDBACK_RATE_LIMIT=120

# Argon2id (mémoire en KiB). Valeurs par défaut : recommandations OWASP.
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# true | false | vide (activé seulement en local et development)
SWAGGER_ENABLED=
METRICS_ENABLED=false
# Obligatoire (≥ 32 caractères) si METRICS_ENABLED=true. Jamais dans le frontend.
# METRICS_SCRAPE_TOKEN=
# Identifiant de build exposé sur GET /health/live (optionnel).
# APP_VERSION=
# GIT_SHA=
# Timeout ms des checks Postgres/Redis pour /health/ready (défaut 2000).
# HEALTH_CHECK_TIMEOUT_MS=2000

# Feature flags (registre @mon-appart/config — docs/feature-flags-architecture.md).
# Les moteurs existants restent la source de vérité (SEARCH_ENGINE, etc.).
# FF_WEB_ASSISTANT=true
# FF_WEB_RECOMMENDATIONS=true
# FF_PARTNERS_API=true
# Côté web (build Next) : NEXT_PUBLIC_FF_WEB_ASSISTANT / NEXT_PUBLIC_FF_WEB_RECOMMENDATIONS
# Purge OTP / reset / sessions hors rétention (0 = CLI seulement).
IDENTITY_RETENTION_INTERVAL_MINUTES=0
IDENTITY_SESSION_RETENTION_DAYS=30
# Pic d'annonces → signal Trust ACCOUNT_BURST_ACTIVITY (revue humaine).
TRUST_LISTING_BURST_THRESHOLD=8
TRUST_LISTING_BURST_WINDOW_HOURS=24
OTEL_ENABLED=false
LOG_LEVEL=info

# Médias (voir docs/media-management.md). Les fichiers ne vont jamais dans PostgreSQL.
# local | s3 | r2. local = disque + liens signés servis par l'API, refusé en
# staging et production.
MEDIA_STORAGE_PROVIDER=local
# Vide = dossier temporaire du système
MEDIA_LOCAL_ROOT=
# URL publique de l'API pour les liens locaux (défaut http://localhost:APP_PORT)
MEDIA_LOCAL_BASE_URL=

# S3 / R2 : bucket privé (originaux, documents, quarantaine). Obligatoires avec
# MEDIA_STORAGE_PROVIDER=s3|r2 ; S3_ENDPOINT obligatoire pour R2.
# Identifiants à portée minimale, jamais committés.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# true pour MinIO et certains endpoints compatibles
S3_FORCE_PATH_STYLE=false
# Bucket public (CDN) distinct : uniquement les variantes publiques traitées.
# Vide = aucune URL permanente, lecture par URL présignée courte.
S3_PUBLIC_BUCKET=
# Obligatoire avec S3_PUBLIC_BUCKET (ex. https://cdn.example.com)
MEDIA_PUBLIC_BASE_URL=

# Durée de validité des URL présignées, en secondes
MEDIA_UPLOAD_URL_TTL_SECONDS=900
MEDIA_DOWNLOAD_URL_TTL_SECONDS=300
# Tailles maximales en octets (15 Mo, 200 Mo, 20 Mo)
MEDIA_MAX_IMAGE_BYTES=15728640
MEDIA_MAX_VIDEO_BYTES=209715200
MEDIA_MAX_DOCUMENT_BYTES=20971520
# Protection contre les bombes de décompression
MEDIA_MAX_IMAGE_PIXELS=50000000
MEDIA_MAX_VIDEO_SECONDS=180
MEDIA_MAX_PER_PROPERTY=30
# Sessions d'envoi ouvertes simultanément par utilisateur
MEDIA_MAX_PENDING_UPLOADS=20

# File de traitement en base, servie par un worker dans le processus de l'API
MEDIA_WORKER_ENABLED=true
MEDIA_WORKER_POLL_MS=2000
MEDIA_WORKER_CONCURRENCY=2
MEDIA_JOB_MAX_ATTEMPTS=5
MEDIA_JOB_TIMEOUT_MS=60000
# Rétention avant purge définitive d'un média supprimé
MEDIA_DELETED_RETENTION_DAYS=30
MEDIA_CLEANUP_INTERVAL_MINUTES=15
# Requêtes par minute et par client
MEDIA_UPLOAD_RATE_LIMIT=30
MEDIA_MUTATION_RATE_LIMIT=60

# Confiance et vérification (voir docs/trust-and-verification.md)
# Validité d'une vérification approuvée, en jours
TRUST_IDENTITY_VALIDITY_DAYS=730
TRUST_PROPERTY_VALIDITY_DAYS=365
TRUST_AGENCY_VALIDITY_DAYS=365
TRUST_LISTING_CHECK_VALIDITY_DAYS=180
# Conservation des pièces après clôture d'un dossier, avant purge
TRUST_DOCUMENT_RETENTION_DAYS=365
TRUST_MAX_DOCUMENTS_PER_VERIFICATION=10
# Déclarants distincts au-delà desquels une cible signalée est priorisée
TRUST_REPORT_REVIEW_THRESHOLD=3
# Variation relative de prix déclenchant une alerte (0.5 = ±50 %)
TRUST_PRICE_CHANGE_ALERT_RATIO=0.5
# Signalements par utilisateur et par jour ; requêtes par minute et par client
TRUST_REPORT_DAILY_LIMIT=20
TRUST_REPORT_RATE_LIMIT=10
TRUST_MUTATION_RATE_LIMIT=30
# Expiration des dossiers et rétention des pièces (0 : tâche en processus désactivée)
TRUST_MAINTENANCE_INTERVAL_MINUTES=60

# Messagerie (voir docs/messaging-and-notifications.md). Les messages sont
# enregistrés en base avant toute notification ; Redis n'est pas requis.
# Limites par utilisateur : conversations par heure, messages par minute
MESSAGING_MAX_CONVERSATIONS_PER_HOUR=20
MESSAGING_MAX_MESSAGES_PER_MINUTE=30
# Conversations distinctes recevant le même texte en une heure avant refus
MESSAGING_REPEAT_LIMIT=5
MESSAGING_MAX_ATTACHMENTS=5
# Délai avant e-mail / SMS d'un message non lu (annulé s'il est lu entre-temps)
MESSAGING_EXTERNAL_DELAY_SECONDS=300
# Requêtes par minute et par client
MESSAGING_RATE_LIMIT=120

# Notifications : file de livraison en base, servie par un worker dans l'API
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_POLL_MS=2000
NOTIFICATION_WORKER_BATCH_SIZE=20
NOTIFICATION_MAX_ATTEMPTS=5
# Base du backoff exponentiel entre deux tentatives
NOTIFICATION_RETRY_BASE_SECONDS=30
NOTIFICATION_PROVIDER_TIMEOUT_MS=10000
# Replis après échec définitif, un seul niveau (ex. EMAIL>SMS) : le canal de
# repli n'est envoyé qu'après l'échec du canal principal. Vide : aucun.
NOTIFICATION_FALLBACKS=

# E-mail : none | smtp. none = canal désactivé, rien n'est planifié.
EMAIL_PROVIDER=none
SMTP_HOST=
SMTP_PORT=587
# true = TLS implicite (465) ; false = STARTTLS exigé
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Ex. "Mon Appart <no-reply@example.com>"
EMAIL_FROM=

# SMS : none | http (passerelle HTTP générique, HTTPS exigé hors développement)
SMS_PROVIDER=none
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
# 11 caractères au plus
SMS_SENDER_ID=

# Push (FCM) et WhatsApp Business : interfaces prêtes, aucun fournisseur actif.
PUSH_PROVIDER=none
WHATSAPP_PROVIDER=none

# Temps réel : Socket.IO sur /realtime (adaptateur Redis si REDIS_URL est défini)
REALTIME_ENABLED=true
REALTIME_REVOCATION_CHECK_SECONDS=60
# Événements entrants par socket et par minute
REALTIME_EVENT_RATE_LIMIT=120

# Rendez-vous : rappel avant une visite confirmée (0 = aucun rappel)
APPOINTMENT_REMINDER_HOURS=24
APPOINTMENT_MIN_NOTICE_MINUTES=60
APPOINTMENT_MAX_DAYS_AHEAD=90
# Requêtes par minute et par client
APPOINTMENT_RATE_LIMIT=30

# Analytics (docs/analytics-and-tracking.md)
ANALYTICS_ENABLED=true
# Version de politique de confidentialité exigée avec le consentement
ANALYTICS_POLICY_VERSION=2026-10
# Lots par minute et par IP
ANALYTICS_RATE_LIMIT=60
# Âge maximal d'un événement client (file hors ligne)
ANALYTICS_MAX_EVENT_AGE_HOURS=72
# Conservation des événements bruts (les agrégats restent)
ANALYTICS_RETENTION_DAYS=395
# Agrégation et purge dans l'API (0 = désactivées, utiliser la CLI)
ANALYTICS_WORKER_INTERVAL_MINUTES=15
# Jours déjà agrégés recalculés à chaque passage (événements tardifs)
ANALYTICS_LATE_DAYS=3
# Lead qualifié : REPLY | APPOINTMENT | REPLY_OR_APPOINTMENT
ANALYTICS_QUALIFIED_LEAD_RULE=REPLY_OR_APPOINTMENT
# Fenêtre d'attribution d'une conversion à une recommandation
ANALYTICS_ATTRIBUTION_HOURS=72
# Taille minimale d'un groupe dans une ventilation administrateur
ANALYTICS_MIN_GROUP_SIZE=5

# Facturation (docs/billing-payments-monetization.md)
# Services de la plateforme uniquement : jamais de loyer, dépôt ni prix de vente.
# none : achats désactivés. mock : simulateur local (aucun argent encaissé),
# refusé au démarrage en staging/production et avec PAYMENT_ENVIRONMENT=live.
# Aucun prestataire réel n'est encore implémenté.
PAYMENT_PROVIDER=none
# test | live (enregistré sur chaque transaction)
PAYMENT_ENVIRONMENT=test
# Secret HMAC du simulateur, 32 caractères minimum, requis avec mock.
# À générer localement ; ne jamais committer de valeur.
PAYMENT_MOCK_WEBHOOK_SECRET=
# Tolérance d'horodatage des signatures de webhook
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# Validité d'une commande en attente de paiement
BILLING_ORDER_TTL_MINUTES=60
BILLING_MAX_ATTEMPTS_PER_ORDER=5
# Grâce après l'échéance avant expiration de l'abonnement
BILLING_GRACE_DAYS=3
# Fenêtre de renouvellement manuel avant l'échéance
BILLING_RENEWAL_WINDOW_DAYS=30
# Rappel avant l'échéance (0 = désactivé)
BILLING_RENEWAL_REMINDER_DAYS=7
# Réconciliation dans l'API (0 = désactivée, utiliser pnpm billing:reconcile)
BILLING_WORKER_INTERVAL_MINUTES=5
# Requêtes par minute et par IP
BILLING_RATE_LIMIT=30
BILLING_WEBHOOK_RATE_LIMIT=600

OPENAI_API_KEY=
# Assistant immobilier (Nest). Extraction = règles ; OpenAI = reformulation optionnelle.
AI_ASSISTANT_ENABLED=true
AI_ASSISTANT_PROVIDER=rules
AI_ASSISTANT_OPENAI_MODEL=gpt-4o-mini
AI_ASSISTANT_TIMEOUT_MS=8000
AI_ASSISTANT_MAX_TOKENS=400
AI_ASSISTANT_MAX_MESSAGE_LENGTH=2000
AI_ASSISTANT_MAX_HISTORY_TURNS=12
AI_ASSISTANT_CONVERSATION_TTL_HOURS=24
AI_ASSISTANT_SEARCH_LIMIT=12
AI_ASSISTANT_RATE_LIMIT=30

# Interactions (favoris, vues) — alimentent le profil de recommandation
INTERACTION_RATE_LIMIT=60

SENTRY_DSN=

WORKER_PORT=4001
RECOMMENDATION_PORT=8000
