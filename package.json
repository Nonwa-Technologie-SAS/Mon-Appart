{
  "name": "mon-appart",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@mon-appart/api --filter=@mon-appart/web --filter=@mon-appart/admin",
    "dev:api": "pnpm --filter @mon-appart/api dev",
    "dev:web": "pnpm --filter @mon-appart/web dev",
    "dev:admin": "pnpm --filter @mon-appart/admin dev",
    "dev:workers": "pnpm --filter @mon-appart/workers dev",
    "dev:recommendation": "py -3 -m uvicorn app.main:app --reload --port 8000 --app-dir services/recommendation",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "turbo run test",
    "test:unit": "pnpm --filter @mon-appart/api test:unit && pnpm --filter @mon-appart/web test",
    "test:integration": "pnpm --filter @mon-appart/api test:db",
    "test:e2e": "pnpm --filter @mon-appart/api test:e2e",
    "test:e2e:web": "pnpm --filter @mon-appart/web test:e2e",
    "test:coverage": "pnpm --filter @mon-appart/api test:coverage",
    "test:contracts": "pnpm --filter @mon-appart/api exec vitest run test/contracts",
    "test:smoke": "pnpm --filter @mon-appart/api test:e2e && pnpm --filter @mon-appart/web test",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @mon-appart/api db:migrate",
    "db:generate": "pnpm --filter @mon-appart/api db:generate",
    "db:seed": "pnpm --filter @mon-appart/api db:seed",
    "db:test:migrate": "pnpm --filter @mon-appart/api db:test:migrate",
    "test:db": "pnpm --filter @mon-appart/api test:db",
    "docker:up": "docker compose -f infrastructure/docker/compose.yaml up -d",
    "docker:down": "docker compose -f infrastructure/docker/compose.yaml down",
    "docker:build:api": "docker build -f apps/api/Dockerfile -t mon-appart-api:local .",
    "docker:build:workers": "docker build -f services/workers/Dockerfile -t mon-appart-workers:local .",
    "docker:build:recommendation": "docker build -f services/recommendation/Dockerfile -t mon-appart-recommendation:local .",
    "smoke:health": "node scripts/smoke-health.mjs",
    "secrets:check": "node scripts/assert-no-tracked-env.mjs",
    "secrets:local": "node scripts/generate-local-secrets.mjs",
    "load:smoke": "k6 run -e BASE_URL=http://127.0.0.1:4000 scripts/load/k6-smoke.js",
    "load:ramp": "k6 run -e BASE_URL=http://127.0.0.1:4000 scripts/load/k6-ramp.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "lint-staged": {
    "apps/api/**/*.{ts,tsx}": [
      "node node_modules/prettier/bin/prettier.cjs --write"
    ],
    "apps/admin/**/*.{ts,tsx,css}": [
      "node node_modules/prettier/bin/prettier.cjs --write"
    ],
    "packages/**/*.{ts,tsx,js,mjs,json}": [
      "node node_modules/prettier/bin/prettier.cjs --write"
    ],
    "services/workers/**/*.ts": [
      "node node_modules/prettier/bin/prettier.cjs --write"
    ],
    "*.{json,md,yml,yaml}": [
      "node node_modules/prettier/bin/prettier.cjs --write"
    ]
  }
}
