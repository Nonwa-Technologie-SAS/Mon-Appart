{
  "name": "@mon-appart/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:e2e": "vitest run test/health.e2e-spec.ts test/contracts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:test:migrate": "tsx prisma/scripts/test-database.ts migrate",
    "db:test:reset": "tsx prisma/scripts/test-database.ts reset",
    "search:reindex": "pnpm run build && node dist/modules/search/cli/search-cli.js reindex",
    "search:health": "pnpm run build && node dist/modules/search/cli/search-cli.js health",
    "search:stats": "pnpm run build && node dist/modules/search/cli/search-cli.js stats",
    "media:process": "pnpm run build && node dist/modules/media/cli/media-cli.js process",
    "media:cleanup": "pnpm run build && node dist/modules/media/cli/media-cli.js cleanup",
    "trust:maintenance": "pnpm run build && node dist/modules/trust/cli/trust-cli.js maintenance",
    "identity:purge-artifacts": "pnpm run build && node dist/modules/identity/cli/identity-cli.js purge-artifacts",
    "media:orphans": "pnpm run build && node dist/modules/media/cli/media-cli.js orphans",
    "analytics:run": "pnpm run build && node dist/modules/analytics/cli/analytics-cli.js run",
    "analytics:recompute": "pnpm run build && node dist/modules/analytics/cli/analytics-cli.js recompute",
    "analytics:purge": "pnpm run build && node dist/modules/analytics/cli/analytics-cli.js purge",
    "billing:reconcile": "pnpm run build && node dist/modules/billing/cli/billing-cli.js reconcile",
    "prebuild": "prisma generate && node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "pretest": "prisma generate",
    "pretest:e2e": "prisma generate",
    "pretypecheck": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@mon-appart/analytics": "workspace:*",
    "@mon-appart/config": "workspace:*",
    "@mon-appart/types": "workspace:*",
    "@mon-appart/validation": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/platform-socket.io": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.1.3",
    "@node-rs/argon2": "^2.0.2",
    "@opensearch-project/opensearch": "^3.9.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "libphonenumber-js": "^1.13.14",
    "nestjs-pino": "^5.3.1",
    "nodemailer": "^10.1.0",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@mon-appart/eslint-config": "workspace:*",
    "@mon-appart/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.14",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^12.1.2",
    "@swc/core": "^1.13.5",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.8",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "pino-pretty": "^13.1.2",
    "prisma": "^7.10.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "unplugin-swc": "^1.5.5",
    "@vitest/coverage-v8": "^3.2.4",
    "vitest": "^3.2.4"
  }
}
