# Copier vers .env à la racine. Ne jamais committer .env.

NODE_ENV=development
APP_ENV=local
APP_PORT=4000

# API NestJS — base dédiée, distincte du prototype web
DATABASE_URL=postgresql://mon_appart:mon_appart_dev@127.0.0.1:5433/mon_appart

# Prototype Next.js existant (apps/web). Ne pas pointer vers la même base que l'API.
# WEB_DATABASE_URL=postgresql://mon_appart:mon_appart_dev@127.0.0.1:5433/mon_appart_legacy

REDIS_URL=redis://127.0.0.1:6380

# Secrets de développement uniquement. Les remplacer hors local.
JWT_SECRET=dev-only-change-me-please-32chars-min
JWT_REFRESH_SECRET=dev-only-refresh-change-me-32chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Origines autorisées, séparées par des virgules. Vide = pas de CORS cross-origin.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# true | false | vide (activé seulement en local et development)
SWAGGER_ENABLED=
METRICS_ENABLED=false
OTEL_ENABLED=false
LOG_LEVEL=info

S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

OPENAI_API_KEY=
SENTRY_DSN=

WORKER_PORT=4001
RECOMMENDATION_PORT=8000
TEST_DATABASE_URL=postgresql://mon_appart:mon_appart_dev@127.0.0.1:5433/mon_appart_test

AUTH_DEV_PRINT_CODES=true