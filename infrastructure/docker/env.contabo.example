# Copier vers infrastructure/docker/.env.contabo (hors Git).
# Générer les secrets : openssl rand -base64 48
# Voir docs/deployment-contabo.md
# Domaine : monappart.ci

# --- Domaines (DNS A → IP Contabo) ---
WEB_DOMAIN=www.monappart.ci
ADMIN_DOMAIN=admin.monappart.ci
API_DOMAIN=api.monappart.ci
# E-mail Let's Encrypt (Caddy)
ACME_EMAIL=ops@monappart.ci

# --- PostgreSQL / Redis (réseau Docker interne uniquement) ---
POSTGRES_USER=mon_appart
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=mon_appart
# Hôte = nom de service Compose (pas 127.0.0.1 : refusé hors local)
DATABASE_URL=postgresql://mon_appart:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/mon_appart
REDIS_URL=redis://redis:6379

# --- Runtime API ---
NODE_ENV=production
APP_ENV=production
APP_PORT=4000
TRUST_PROXY=1
LOG_LEVEL=info
SWAGGER_ENABLED=false
METRICS_ENABLED=false
AUTH_DEV_PRINT_CODES=false
PAYMENT_PROVIDER=none
PAYMENT_ENVIRONMENT=test
SEARCH_ENGINE=postgres
RECOMMENDATION_ENGINE=rules

JWT_SECRET=CHANGE_ME_JWT_ACCESS_MIN_32_CHARS_xxxxxxxxxxxx
JWT_REFRESH_SECRET=CHANGE_ME_JWT_REFRESH_DIFFERENT_32_CHARS_xx
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

WEB_APP_URL=https://www.monappart.ci
ADMIN_APP_URL=https://admin.monappart.ci
CORS_ORIGINS=https://www.monappart.ci,https://admin.monappart.ci,https://monappart.ci

# Next (build + runtime) — rewrite vers l'API interne
NEST_API_URL=http://api:4000
ADMIN_API_URL=http://api:4000
NEXT_PUBLIC_NEST_API_URL=same-origin
NEXT_PUBLIC_SITE_URL=https://www.monappart.ci

# --- Médias : local interdit en production ---
# Option A (recommandée) : Cloudflare R2
MEDIA_STORAGE_PROVIDER=r2
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=mon-appart-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
# S3_PUBLIC_BUCKET=
# MEDIA_PUBLIC_BASE_URL=https://cdn.monappart.ci

# Option B (DIY Contabo) : MinIO du compose (profil minio)
# MEDIA_STORAGE_PROVIDER=s3
# S3_ENDPOINT=http://minio:9000
# S3_REGION=us-east-1
# S3_BUCKET=mon-appart-media
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=CHANGE_ME_MINIO_SECRET
# S3_FORCE_PATH_STYLE=true

# --- E-mail (optionnel au début) ---
EMAIL_PROVIDER=none
# EMAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM="Mon Appart <no-reply@monappart.ci>"

SMS_PROVIDER=none
